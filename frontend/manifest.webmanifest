{
  "name": "Dhyey Clinic Management System",
  "short_name": "Dhyey CMS",
  "description": "Next-Generation Clinical Management, Digital Prescriptions, Billing & Multi-Clinic OPD Management",
  "start_url": "/index.html",
  "scope": "/",
  "id": "/index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#0d6efd",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["medical", "health", "productivity", "utilities", "business"],
  "icons": [
    {
      "src": "/assets/icons/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Doctor Dashboard",
      "short_name": "Dashboard",
      "description": "Open Doctor Clinical Dashboard",
      "url": "/index.html?view=dashboard",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Receptionist Desk",
      "short_name": "Reception",
      "description": "Open Receptionist OPD Desk",
      "url": "/pages/receptionist/dashboard.html",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Admin Portal",
      "short_name": "Admin",
      "description": "Open System Admin Analytics & Clinic Control",
      "url": "/pages/admin/dashboard.html",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "New Patient Registration",
      "short_name": "Add Patient",
      "description": "Register New Family or Patient Member",
      "url": "/index.html?view=family",
      "icons": [{ "src": "/assets/icons/icon.svg", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
